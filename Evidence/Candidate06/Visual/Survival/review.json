  "findings": [
    {
      "topic": "Health wait, accepted-hit reset and recovery",
      "viewed_frames": [
        "Media/frame_00050.jpg",
        "Media/frame_00051.jpg",
        "Media/frame_00403.jpg",
        "Media/frame_00435.jpg",
