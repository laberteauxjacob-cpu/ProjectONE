  "findings": [
    {
      "subject": "Machine lighting and assembled preview",
      "capture_evidence": [
        {
          "capture_id": "20260905_125659_E8EDAEE6",
          "frames": [
            633,
            649
          ]
        },
        {
          "capture_id": "20260905_130222_160831EC",
          "frames": [
            829,
            840,
            937,
            945
          ]
        }
      ],
      "observation": "The relocated overhead light leaves the rifle distinct from the tray and preserves shading on the arms. The cyan processing preview and green waiting preview have discernible weapon and cradle forms. The green cast remains strong and a small bright housing highlight remains, but these inspected views do not show the old broad white wash over the hands and rifle.",
      "limit": "Qualitative comparison with previously reviewed editor captures, not a controlled brightness measurement. Fine receiver/finger detail remains dark and small."
    },
    {
      "subject": "M4 handoff and retrieval",
      "capture_evidence": [
        {
          "capture_id": "20260905_125659_E8EDAEE6",
          "frames": [
            633,
            649
          ]
        },
        {
          "capture_id": "20260905_130222_160831EC",
          "frames": [
            937,
            945,
            950
          ]
        }
      ],
      "observation": "The first sequence moves from the held rifle into tray acceptance and preview rotation. In the second capture the assembled waiting rifle turns toward the approaching hands and is pulled into carry; sparse frame 950 shows the held rifle with an empty tray. No obvious lasting duplicate rifle or large position pop was observed within these reviewed intervals.",
      "limit": "The second dense interval ends before the sparse ready endpoint; intermediate frames 946-949 were not inspected. Exact finger-to-grip contact and sub-frame continuity are not certified."
    },
    {
      "subject": "M1911 reload and magazine",
      "capture_evidence": [
        {
          "capture_id": "20260905_130222_160831EC",
          "frames": [
            59,
            66,
            75,
            83,
            91
          ]
        }
      ],
      "observation": "The support arm opens away from the torso in the dense removal/reach subwindow. Later sparse images show a separate rectangular dropped magazine below and to screen-left of the feet, followed by the return to a two-hand carry pose.",
      "limit": "The pistol and hands occupy very few native pixels and overlap the body. The fresh magazine seating, exact release frame, and slide travel cannot be independently resolved in this selection. This is not a complete dense reload review, and ammo text is not used as proof of physical seating."
    },
    {
      "subject": "Remington 870 shot, pump and case",
      "capture_evidence": [
        {
          "capture_id": "20260905_130222_160831EC",
          "frames": [
            2016,
            2032
          ]
        }
      ],
      "observation": "Frame 2016 shows a short pale flash at the barrel end, separate long fired trajectories, and local illumination on the upper body. The flash is absent in subsequent inspected frames. A small red case becomes visible near the gun and moves outward to screen-right and downward across the latter pump frames. The weapon stays in the held pose during recovery.",
      "limit": "Support-arm and fore-end displacement is subtle from this nearly frontal top-down angle. The images support a visible case trajectory but do not measure pump travel, contact error, or an ejection count across the full capture."
    },
    {
      "subject": "Individual shotgun shell insertion",
      "capture_evidence": [
        {
          "capture_id": "20260905_130222_160831EC",
          "frames": [
            2115,
            2122
          ]
        }
      ],
      "observation": "The support arm moves inward from an open elbow position toward the receiver while the shotgun is held diagonally. The arm motion is more legible than the tiny loading prop.",
      "limit": "The shell is obscured by the hands and receiver at this distance. Physical shell seating and finger contact are unresolved. This is a short receiver-approach subwindow, not every frame of the entire first shell cycle."
    },
    {
      "subject": "Gravebreaker upgraded appearance and pump",
      "capture_evidence": [
        {
          "capture_id": "20260905_130222_160831EC",
          "frames": [
            2692,
            2696,
            2704
          ]
        }
      ],
      "observation": "The upgraded shotgun retains a dark gun silhouette with warm copper/ember detail instead of a uniformly glowing surface. Sparse frame 2692 shows a short muzzle flash and warm fired trajectories. In the dense pump subwindow a small red case moves away to screen-right and downward; the held gun remains stable through recovery.",
      "limit": "The warm trim is subdued at native gameplay scale; small fore-end displacement and exact support-hand contact remain difficult to distinguish. The flash frame is a sparse endpoint separated from the dense pump interval."
    },
    {
      "subject": "Persistent missing HUD glyphs",
